<mxfile host="app.diagrams.net" agent="SavoryStay" version="24.0.0">
  <diagram id="savorystay-architecture" name="SavoryStay Architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ══════════ Actors (left) ══════════ -->
        <mxCell id="U" value="👤 Guest / Customer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="170" height="50" as="geometry" />
        </mxCell>
