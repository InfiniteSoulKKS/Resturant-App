          <mxGeometry x="230" y="60" width="340" height="420" as="geometry" />
        </mxCell>
        <mxCell id="C1" value="components (21 files)&#10;AuthModal · CustomerMenuView · MenuManagement&#10;PreBookingsDashboard · RealtimePaymentModal&#10;OrderTracking · StaffManagement · SuperAdminDashboard&#10;IngredientPlanning · ManagerDashboard · AdminDashboard&#10;ChefPrepSummary · NotificationsBell · RestaurantPicker&#10;RestaurantSelector · CustomerMembershipManager&#10;PreOrderSettings · BottomNav · Header&#10;AvailabilityWarningModal · BackendInspectorModal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#78350f;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
