# ========== MySQL Configuration ==========
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=savorystay_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# ========== JWT Configuration ==========
# Required — the app rejects token signing/validation until this is set.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long

# ========== Redis (optional — shared rate-limit / lockout store) ==========
# Needed for multi-instance deployments so every backend shares the same
# login lockout and OTP throttling state. If Redis is down, the app fails OPEN
# (requests allowed) and rate limiting is temporarily disabled.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== Email Configuration (ElasticEmail SMTP) ==========
# SMTP: smtp.elasticemail.com, port 2525 (STARTTLS).
# Username = your ElasticEmail account email.
# Password = API key / SMTP password from
#            https://app.elasticemail.com/settings/smtp
# The From address used on emails is MAIL_USERNAME and must be a verified
# sender in your ElasticEmail account.
MAIL_HOST=smtp.elasticemail.com
MAIL_PORT=2525
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-elasticemail-api-key

# ========== Kafka (event backbone for real-time notifications) ==========
# Start the local broker with: docker compose up -d  (see docker-compose.yml)
# OTP emails, order status/prep updates, payment receipts and inventory
# alerts all flow through Kafka topics into the Gmail/Twilio delivery consumers.
# localhost:29092 is the broker's HOST listener (used by the backend).
# Dockerized clients (kafka-ui) connect via the in-network listener kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_CONSUMER_GROUP=savorystay-notifications

# Public app URL used in email footers / links
APP_URL=http://localhost:5173

# ========== Twilio Configuration (SMS & WhatsApp) ==========
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890  # Your Twilio SMS-enabled phone number
TWILIO_WHATSAPP_NUMBER=+14155238886  # Your Twilio WhatsApp-enabled number (usually provided by Twilio)

# ========== Stripe Configuration ==========
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ========== PayPal Configuration ==========
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
