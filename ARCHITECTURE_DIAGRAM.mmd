flowchart TD
    %% ─── Styling ───
    classDef fe fill:#fef3c7,stroke:#d97706,color:#78350f,stroke-width:2px
    classDef be fill:#e0e7ff,stroke:#4338ca,color:#1e1b4b,stroke-width:2px
    classDef data fill:#d1fae5,stroke:#059669,color:#064e3b,stroke-width:2px
    classDef ext fill:#fce7f3,stroke:#db2777,color:#831843,stroke-width:2px
    classDef sec fill:#fee2e2,stroke:#dc2626,color:#7f1d1d,stroke-width:2px

    %% ─── Actors ───
    U[👤 Guest / Customer]
    S[👨‍🍳 Chef]
    M[📊 Manager / Admin]
    A[🏢 Super Admin]

    %% ─── Frontend ───
    subgraph FE["Frontend — React SPA (Vite :5173)"]
        direction TB
        C1["components/<br/>AuthModal · CustomerMenuView · MenuManagement<br/>PreBookingsDashboard · RealtimePaymentModal · OrderTracking<br/>StaffManagement · SuperAdminDashboard · IngredientPlanning …"]
        C2["lib/<br/>apiClient · tokenManager · roles.ts"]
        C3["hooks/<br/>useRealtimeNotifications (SSE client)"]
    end

    %% ─── Backend ───
    subgraph BE["Backend — Spring Boot 3.2 (:8080)"]
        direction TB
        SEC["Security Layer<br/>JwtAuthenticationFilter · JwtTokenProvider · RoleUtils<br/>TenantContextFilter · AuthRateLimitService (Redis)"]
        CTRL["Controllers<br/>Auth · Otp · Order · Menu · Payment<br/>Ingredient · Restaurant · Staff · Notification"]
        SVC["Services<br/>OtpService · OrderService · MenuService · PaymentGatewayService<br/>IngredientService · NotificationService · RealtimeService<br/>ChannelDeliveryService · OutboxService"]
        SCH["Schedulers<br/>OtpCleanupScheduler (15 min) · OutboxPoller"]
        REPO["JPA Repositories (15)"]
    end

    %% ─── Data / Infra ───
    DB[("MySQL<br/>users · restaurants · menu_items · orders<br/>order_items · payments · ingredients<br/>otp_requests · price_rules · outbox_events")]
    RD[("Redis<br/>rate limits · lockout state")]

    %% ─── External services ───
    subgraph EXT["External Providers"]
        TW["Twilio<br/>SMS + WhatsApp"]
        SM["SMTP / Spring Mail<br/>Email"]
        ST["Stripe<br/>PaymentIntent"]
        PP["PayPal<br/>Checkout SDK"]
    end

    %% ─── Flows ───
    U -->|"browse · cart · pre-book · pay · track"| FE
    S -->|"kitchen queue · cook/pack"| FE
    M -->|"prices · staff · complete orders"| FE
    A -->|"chain dashboard"| FE

    FE -->|"HTTPS /api/v1/*<br/>Bearer JWT"| SEC
    SEC --> CTRL
    CTRL --> SVC
    SVC --> REPO
    SVC --> SCH
    REPO -->|"JPA/Hibernate"| DB
    SEC -->|"rate-limit + lockout"| RD

    SCH -->|"drain outbox events"| SVC
    SVC -->|"notification delivery"| TW
    SVC -->|"email OTP"| SM
    SVC -->|"payment intents"| ST
    SVC -->|"checkout orders"| PP

    SVC -->|"SSE stream /api/v1/realtime/stream"| C3
    C3 -->|"live events → notifications bell · order refresh"| C1

    class U,S,M,A fe
    class C1,C2,C3 fe
    class SEC,CTRL,SVC,SCH,REPO be
    class DB,RD data
    class TW,SM,ST,PP ext
